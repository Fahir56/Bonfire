  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
  <application android:allowBackup="false" android:label="Bonfire" android:usesCleartextTraffic="false" android:icon="@drawable/bonfire_icon" android:theme="@android:style/Theme.Material.NoActionBar" android:supportsRtl="true">
